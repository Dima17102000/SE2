@startuml
title PDP1 - Stage 2: Project-Based Task Management

hide circle
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam shadowing false

package "pdp1.model" {

    class Task {
        - id: UUID
        - validator: TaskValidator
        - name: String
        - description: String
        - dueDate: LocalDate
        - completed: boolean
        --
        + Task(name: String, description: String, dueDate: LocalDate)
        + Task(name: String, description: String, dueDate: LocalDate, validator: TaskValidator)
        + getId(): UUID
        + getName(): String
        + setName(name: String): void
        + getDescription(): String
        + setDescription(description: String): void
        + getDueDate(): LocalDate
        + setDueDate(dueDate: LocalDate): void
        + isCompleted(): boolean
        + setCompleted(completed: boolean): void
        + toString(): String
    }

    class User {
        - id: UUID
        - username: String
        - email: String
        - passwordHash: String
        --
        + getUsername(): String
        + getEmail(): String
        + verifyPassword(password: String): boolean
    }

    class Category {
        - id: UUID
        - name: String
        --
        + getId(): UUID
        + getName(): String
        + setName(name: String): void
    }

    class Project {
        - id: UUID
        - name: String
        - description: String
        --
        + Project(name: String, description: String)
        + getId(): UUID
        + getName(): String
        + setName(name: String): void
        + getDescription(): String
        + setDescription(description: String): void
    }
}

package "pdp1.service" {

    class TaskManager {
        - tasks: Map<UUID, Task>
        - projects: Map<UUID, Project>
        - validator: TaskValidator
        --
        + TaskManager()
        + TaskManager(validator: TaskValidator)
        + addTask(task: Task): void
        + getTaskById(id: UUID): Task
        + updateTask(id: UUID, name: String, description: String, dueDate: LocalDate, completed: boolean): void
        + searchTasks(query: String): List<Task>
        + getAllTasks(): List<Task>
        + displayTasks(): String
        --
        + addProject(project: Project): void
        + getProjectById(id: UUID): Project
        + getAllProjects(): List<Project>
        + assignTaskToProject(taskId: UUID, projectId: UUID): void
        + removeTaskFromProject(taskId: UUID): void
    }
}

package "pdp1.validation" {

    class TaskValidator {
        + validateName(name: String): String
        + validateDescription(description: String): String
        + validateDueDate(dueDate: LocalDate): LocalDate
        + validateSearchQuery(query: String): String
    }
}

' Single-user relationships
User "1" -- "1" TaskManager : uses
User "1" -- "0..*" Task : owns
User "1" -- "0..*" Project : owns

' Task and project management
TaskManager "1" o-- "0..*" Task : manages
TaskManager "1" o-- "0..*" Project : manages

' Optional project association
Project "0..1" -- "0..*" Task : groups

' Category assignment
Task "0..*" -- "1..*" Category : categorized as

' Validator associations
Task --> "1" TaskValidator : validator
TaskManager --> "1" TaskValidator : validator

note right of Project
  A project can contain zero or more tasks.
  Each task can belong to at most one project.
  Tasks without a project are allowed.
end note

note bottom of User
  Stage 2 still supports a single user.
  The user owns tasks and projects.
end note

note bottom of Category
  Each task belongs to at least one category.
  A category can be assigned to zero or more tasks.
end note

note bottom of TaskManager
  Project management methods are proposed
  extensions for Stage 2.
end note

@enduml
